# LibraInmo — variables de entorno. Copiar a .env y completar.
# Ningún valor real de este archivo entra al repo.

# PostgreSQL es el único motor de la familia: no hay default a SQLite a
# propósito. Local con el compose, el host es el nombre del servicio. Es UNA sola
# base: el dominio, `libraauth` y el schema de `libracore` conviven en ella (ADR-002).
LIBRAINMO_POSTGRES_PASSWORD=CAMBIAR
LIBRAINMO_DATABASE_URL=postgresql+psycopg://librainmo:CAMBIAR@librainmo-postgres:5432/librainmo

ENTORNO=dev
DEBUG=0

# Huso horario del ecosistema: UTC-3 fijo, sin horario de verano.
TZ=America/Argentina/Buenos_Aires

# Firma de la cookie de sesión. Sin esto la app NO levanta (salvo
# ENV=development, que sólo sirve para correr local).
SECRET_KEY=CAMBIAR

# Usuario inicial. Fail-closed: sin la contraseña la app no arranca, en vez de
# crear un admin con una clave que nadie eligió.
LIBRAINMO_ADMIN_USERNAME=admin
LIBRAINMO_ADMIN_PASSWORD=CAMBIAR
